ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# optional
# LAZARUS_MODEL=google_genai:gemini-2.5-flash
# LAZARUS_DEVICE=cpu

# Persistence: explicitly choose local or supabase. Cloud mode never falls back to disk.
LAZARUS_STORAGE_BACKEND=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...  # server only; never use VITE_ for secrets
# SUPABASE_STORAGE_BUCKET=lazarus-archives
# LAZARUS_KEY_ENCRYPTION_KEY=       # base64 32-byte key; keep a secure independent backup
# SUPABASE_DB_URL=                 # setup only: database connection URL (keep server-side)
